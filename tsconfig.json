{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    // Environment setup & latest features
    "types": ["bun"],

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,

    // Module resolution
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "benchmarks/**/*", "tests/**/*"]
}
